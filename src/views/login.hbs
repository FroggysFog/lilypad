<!DOCTYPE html>
<html lang="en">

<head>
    <!-- Meta Tags -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>{{{siteTitle}}} &middot; {{{title}}}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="LilyPad ERP">
    <meta name="author" content="LilyPad Systems">
    <meta name="robots" content="index, follow">
    
    <!-- Favicon -->
    <link rel="shortcut icon" href="/themes/lilypad/img/favicon.png">

    <!-- Apple Icon -->
    <link rel="apple-touch-icon" href="/themes/lilypad/img/apple-icon.png">

    <!-- Bootstrap CSS from uploaded theme -->
    <link rel="stylesheet" href="/themes/lilypad/css/bootstrap.min.css">

    <!-- Tabler Icon CSS from uploaded theme -->
    <link rel="stylesheet" href="/themes/lilypad/plugins/tabler-icons/tabler-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">

    <!-- Main CSS from uploaded theme -->
    <link rel="stylesheet" href="/themes/lilypad/css/style.css" id="app-style">
    
    <style>
        :root {
            --primary: #047d24;
            --primary-hover: #035c1a;
        }
        .btn-primary {
            background-color: #047d24 !important;
            border-color: #047d24 !important;
            box-shadow: 0 4px 12px rgba(4, 125, 36, 0.25) !important;
        }
        .btn-primary:hover, .btn-primary:focus {
            background-color: #035c1a !important;
            border-color: #035c1a !important;
            box-shadow: 0 6px 16px rgba(4, 125, 36, 0.35) !important;
        }
        .form-control:focus {
            border-color: #047d24 !important;
            box-shadow: 0 0 0 3px rgba(4, 125, 36, 0.2) !important;
        }
        .form-check-input:checked {
            background-color: #047d24 !important;
            border-color: #047d24 !important;
        }
        .link-hover:hover {
            color: #047d24 !important;
        }
        .account-bg-01 {
            background-image: url('/themes/lilypad/img/authentication/login-bg.jpg') !important;
            background-repeat: no-repeat;
            background-size: cover;
            background-position: center;
            border-radius: 10px;
            height: calc(100vh - 40px);
        }
        .hide { display: none !important; }
    </style>

    <!-- Core Scripts -->
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/vendor.js"></script>
    <script src="/js/truRequire.js"></script>
</head>

<body class="account-page bg-white">

    <!-- Begin Wrapper -->
    <div class="main-wrapper">

       <div class="overflow-hidden p-3 acc-vh">
            
            <!-- start row -->
            <div class="row vh-100 w-100 g-0"> 

                <div class="col-lg-6 vh-100 overflow-y-auto overflow-x-hidden">

                     <!-- start row -->
                    <div class="row">

                        <div class="col-md-10 mx-auto">
                            <!-- Sign In Form -->
                            <form id="loginForm" method="post" action="/login" class="vh-100 d-flex justify-content-between flex-column p-4 pb-0">
                                <div class="text-center mb-4 auth-logo">
                                    <div class="d-inline-flex align-items-center gap-2">
                                        <img src="{{pageLogo}}" onerror="this.onerror=null; this.src='/themes/lilypad/img/logo.svg';" class="img-fluid" alt="{{siteTitle}}" style="max-height: 42px;">
                                    </div>
                                </div>
                                
                                <div id="loginFormFields">
                                    <!-- Flash Message Alert -->
                                    {{#if flash}}
                                    <div class="alert {{#if flash.success}}alert-success{{else}}alert-danger{{/if}} mb-3" role="alert">
                                        {{#if flash.message}}{{{flash.message}}}{{else}}{{{flash}}}{{/if}}
                                    </div>
                                    {{/if}}

                                    <!-- AJAX Alert -->
                                    <div id="ajaxAlert" class="alert alert-success hide mb-3" role="alert"></div>

                                    <div class="mb-3">
                                        <h3 class="mb-2">Sign In</h3>
                                        <p class="mb-0 text-muted">Access the LilyPad ERP panel using your email and passcode.</p>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold" for="login-username">Username or Email</label>
                                        <div class="input-group input-group-flat">
                                            <input type="text" id="login-username" name="login-username" class="form-control" placeholder="Enter username or email" required autocomplete="username">
                                            <span class="input-group-text">
                                                <i class="ti ti-mail"></i>
                                            </span>
                                        </div>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold" for="login-password">Password</label>
                                        <div class="input-group input-group-flat pass-group">
                                            <input type="password" id="login-password" name="login-password" class="form-control pass-input" placeholder="Enter password" required autocomplete="current-password">
                                            <span class="input-group-text toggle-password cursor-pointer">
                                                <i class="ti ti-eye-off"></i>
                                            </span>
                                        </div>
                                    </div>
                                    
                                    <div class="d-flex align-items-center justify-content-between mb-3">
                                        <div class="form-check form-check-md d-flex align-items-center">
                                            <input class="form-check-input mt-0" type="checkbox" value="" id="checkebox-md" checked>
                                            <label class="form-check-label text-dark ms-1" for="checkebox-md">
                                                Remember Me
                                            </label>
                                        </div>
                                        {{#if mailerEnabled}}
                                        <div class="text-end">
                                            <a id="forgotPassLink" href="#" class="link-danger fw-medium link-hover">Forgot Password?</a>
                                        </div>
                                        {{/if}}
                                    </div>
                                    
                                    <div class="mb-3">
                                        <button type="submit" class="btn btn-primary w-100 shadow-sm py-2">Sign In</button>
                                    </div>
                                    
                                    {{#if allowUserRegistration}}
                                    <div class="mb-3 text-center">
                                        <p class="mb-0 text-muted">New on our platform? <a href="/signup" class="link-indigo fw-bold link-hover">Create an account</a></p>
                                    </div>
                                    {{/if}}
                                    
                                    <div class="or-login text-center position-relative mb-3">
                                        <h6 class="fs-14 mb-0 position-relative text-body">OR</h6>
                                    </div>
                                    
                                    <div class="d-flex align-items-center justify-content-center flex-wrap gap-2 mb-3">
                                        <div class="text-center flex-fill">
                                            <a href="javascript:void(0);" class="p-2 btn btn-info d-flex align-items-center justify-content-center">
                                                <img class="img-fluid m-1" src="/themes/lilypad/img/icons/facebook-logo.svg" alt="Facebook" width="20">
                                            </a>
                                        </div>
                                        <div class="text-center flex-fill">
                                            <a href="javascript:void(0);" class="p-2 btn btn-outline-light border d-flex align-items-center justify-content-center">
                                                <img class="img-fluid m-1" src="/themes/lilypad/img/icons/google-logo.svg" alt="Google" width="20">
                                            </a>
                                        </div>
                                        <div class="text-center flex-fill">
                                            <a href="javascript:void(0);" class="p-2 btn btn-dark d-flex align-items-center justify-content-center">
                                                <img class="img-fluid m-1" src="/themes/lilypad/img/icons/apple-logo.svg" alt="Apple" width="20">
                                            </a>
                                        </div>
                                    </div>
                                </div>

                                {{#if mailerEnabled}}
                                <!-- Forgot Password Section (Toggled) -->
                                <div id="forgotPassSection" class="hide">
                                    <div class="mb-3">
                                        <h3 class="mb-2">Reset Password</h3>
                                        <p class="mb-0 text-muted">Enter your registered email and we'll send reset instructions.</p>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold" for="forgotPass-email">Email Address</label>
                                        <div class="input-group input-group-flat">
                                            <input type="email" id="forgotPass-email" name="forgotPass-email" class="form-control" placeholder="Enter your email">
                                            <span class="input-group-text">
                                                <i class="ti ti-mail"></i>
                                            </span>
                                        </div>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <button type="button" id="btnForgotSubmit" class="btn btn-primary w-100 py-2">Send Reset Link</button>
                                    </div>
                                    
                                    <div class="text-center">
                                        <a id="backToLoginLink" href="#" class="text-secondary fw-semibold">
                                            <i class="ti ti-arrow-left"></i> Back to Sign In
                                        </a>
                                    </div>
                                </div>
                                {{/if}}

                                <div class="text-center pb-4">
                                    <p class="text-dark mb-0 fs-13">{{bottom}}</p>
                                </div>
                            </form>
                        </div> <!-- end col -->

                    </div>
                    <!-- end row -->

                </div>

                <!-- Hero Artwork on Right Side -->
                <div class="col-lg-6 account-bg-01"></div> <!-- end col -->

            </div>
            <!-- end row -->

        </div>

    </div>
    <!-- End Wrapper -->

    <!-- Bootstrap Core JS from uploaded theme -->
    <script src="/themes/lilypad/js/bootstrap.bundle.min.js"></script>    

    <!-- Main JS from uploaded theme -->
    <script src="/themes/lilypad/js/script.js"></script>

    <!-- Client-side Logic -->
    <script type="text/javascript">
        window.truRequire(['jquery'], function(loadedModules) {
            var $ = loadedModules[0] || window.jQuery || window.$;

            // Password Toggle
            $(document).on('click', '.toggle-password', function(e) {
                var input = $(this).closest('.input-group').find('.pass-input');
                var icon = $(this).find('i');
                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    icon.removeClass('ti-eye-off').addClass('ti-eye');
                } else {
                    input.attr('type', 'password');
                    icon.removeClass('ti-eye').addClass('ti-eye-off');
                }
            });

            // Toggle forgot password
            $('#forgotPassLink').click(function(e) {
                e.preventDefault();
                $('#loginFormFields').addClass('hide');
                $('#forgotPassSection').removeClass('hide');
                $('#forgotPass-email').focus();
            });

            $('#backToLoginLink').click(function(e) {
                e.preventDefault();
                $('#forgotPassSection').addClass('hide');
                $('#loginFormFields').removeClass('hide');
                $('#login-username').focus();
            });

            // AJAX Forgot Password
            $('#btnForgotSubmit').click(function(e) {
                e.preventDefault();
                var email = $('#forgotPass-email').val().trim();
                if (!email) return;

                var btn = $(this);
                btn.prop('disabled', true).text('Sending...');

                $.ajax({
                    type: 'POST',
                    url: '/forgotpass',
                    data: { 'forgotPass-email': email },
                    success: function() {
                        btn.prop('disabled', false).text('Send Reset Link');
                        $('#forgotPass-email').val('');
                        $('#ajaxAlert').removeClass('hide alert-danger').addClass('alert-success').text('Password reset email sent!').fadeIn();
                        $('#forgotPassSection').addClass('hide');
                        $('#loginFormFields').removeClass('hide');
                    },
                    error: function(xhr) {
                        btn.prop('disabled', false).text('Send Reset Link');
                        $('#ajaxAlert').removeClass('hide alert-success').addClass('alert-danger').text(xhr.responseText || 'Error resetting password').fadeIn();
                    }
                });
            });

            $(document).ready(function() {
                if (screen.width <= 800) {
                    document.location = '/mobile';
                }
                setTimeout(function() {
                    $('#login-username').focus();
                }, 300);
            });
        });
    </script>
</body>

</html>

